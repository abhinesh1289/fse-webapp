@{
    ViewData["Title"] = "Error";
    var statusCode = ViewBag.StatusCode as int?;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">
                    @if (statusCode == 404)
                    {
                        <div class="mb-4">
                            <i class="bi bi-exclamation-circle text-warning"
                               style="font-size: 70px;"></i>
                        </div>

                        <h1 class="h3 mb-3">
                            Page Not Found
                        </h1>
                        <p class="text-muted">
                            The page you requested does not exist
                            or may have been moved.
                        </p>
                    }
                    else if (statusCode != null)
                    {
                        <div class="mb-4">
                            <i class="bi bi-exclamation-triangle text-danger"
                               style="font-size: 70px;"></i>
                        </div>
                        <h1 class="h3 mb-3">
                            Request Failed
                        </h1>
                        <p class="text-muted">
                            The request failed with status code
                            <strong>@statusCode</strong>.
                        </p>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="bi bi-x-circle text-danger"
                               style="font-size: 70px;"></i>
                        </div>

                        <h1 class="h3 mb-3">
                            Something Went Wrong
                        </h1>

                        <p class="text-muted">
                            An unexpected error occurred.
                            Please try again.
                        </p>
                    }


                    <div class="d-flex justify-content-center gap-2 mt-4">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-primary">

                                <i class="bi bi-speedometer2"></i>
                                Back to Dashboard

                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-primary">

                                <i class="bi bi-box-arrow-in-right"></i>
                                Go to Login

                            </a>
                        }

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="history.back()">

                            <i class="bi bi-arrow-left"></i>
                            Go Back
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
