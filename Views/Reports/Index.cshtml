@{
    ViewData["Title"] = "Reports";
}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-file-earmark-bar-graph"></i>
                Reports
            </h2>
            <p class="text-muted mb-0">
                View inventory and activity reports.
            </p>
        </div>
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>
    </div>
    <!-- Report Cards -->
    <div class="row g-4">
        <!-- Inventory Register -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-box-seam"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Inventory Register
                    </h5>
                    <p class="text-muted">
                        View the complete list of inventory
                        assets and their details.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Inventory"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
        <!-- Status Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-bar-chart"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Status Report
                    </h5>
                    <p class="text-muted">
                        View assets grouped by their current
                        status.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Status"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
        <!-- Category Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-tags"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Category Report
                    </h5>
                    <p class="text-muted">
                        View inventory grouped by category.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Category"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
        <!-- Location Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-geo-alt"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Location Report
                    </h5>
                    <p class="text-muted">
                        View assets grouped by location.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Location"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
        <!-- Department Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-diagram-3"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Department Report
                    </h5>
                    <p class="text-muted">
                        View assets grouped by department.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Department"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
        <!-- Activity Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-clock-history"
                           style="font-size: 40px;"></i>
                    </div>
                    <h5>
                        Activity Report
                    </h5>
                    <p class="text-muted">
                        View important inventory and user
                        activities.
                    </p>
                    <a asp-controller="Reports"
                       asp-action="Activity"
                       class="btn btn-primary">
                        <i class="bi bi-eye"></i>
                        View Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
