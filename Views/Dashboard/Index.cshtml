@model InventoryManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
<div class="container-fluid py-4">
    <div class="mb-4">
        <h2>
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </h2>
        <p class="text-muted mb-2">
            Welcome, @Model.UserName
        </p>
        <span class="badge bg-primary">
            @Model.UserRole
        </span>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-box-seam"></i>
                        Total Assets
                    </h6>
                    <h2 class="mb-0">
                        @Model.TotalAssets
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-check-circle"></i>
                        Available
                    </h6>
                    <h2 class="mb-0">
                        @Model.AvailableAssets
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-person-check"></i>
                        Assigned
                    </h6>

                    <h2 class="mb-0">
                        @Model.AssignedAssets
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-tools"></i>
                        Under Maintenance
                    </h6>

                    <h2 class="mb-0">
                        @Model.MaintenanceAssets
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-exclamation-triangle"></i>
                        Damaged
                    </h6>

                    <h2 class="mb-0">
                        @Model.DamagedAssets
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        <i class="bi bi-archive"></i>
                        Retired
                    </h6>

                    <h2 class="mb-0">
                        @Model.RetiredAssets
                    </h2>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-tags"></i>
                Category Summary
            </h5>
        </div>
        <div class="card-body">
            @if (Model.CategorySummary != null &&
                 Model.CategorySummary.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Assets</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CategorySummary)
                            {
                                <tr>
                                    <td>
                                        @item.CategoryName
                                    </td>
                                    <td>
                                        @item.Count
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No assets have been added yet.
                </p>
            }
        </div>
    </div>
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-bar-chart"></i>
                Status Summary
            </h5>
        </div>
        <div class="card-body">
            @if (Model.StatusSummary != null &&
                 Model.StatusSummary.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Assets</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.StatusSummary)
                            {
                                <tr>
                                    <td>
                                        @item.Status
                                    </td>
                                    <td>
                                        @item.Count
                                    </td>
                                    <td>
                                        @item.Percentage%
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No asset status data available.
                </p>
            }
        </div>
    </div>
    <!-- Quick Actions -->
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-lightning"></i>
                Quick Actions
            </h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Assets"
                   asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-box-seam"></i>
                    View Assets
                </a>
                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    <i class="bi bi-tags"></i>
                    Categories
                </a>
                <a asp-controller="Reports"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    <i class="bi bi-file-earmark-text"></i>
                    Reports
                </a>
            </div>
        </div>
    </div>
</div>
