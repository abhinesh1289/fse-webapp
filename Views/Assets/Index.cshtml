@model IEnumerable<InventoryManagementSystem.Models.Assest>

@{
    ViewData["Title"] = "Assets";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-box-seam"></i>
                Assets
            </h2>

            <p class="text-muted mb-0">
                Manage inventory assets.
            </p>
        </div>

        <div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-speedometer2"></i>
                Dashboard

            </a>

        </div>

    </div>


    <!-- Assets Card -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Asset List
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>

                                <th>Asset Code</th>

                                <th>Asset Name</th>

                                <th>Category</th>

                                <th>Serial Number</th>

                                <th>Location</th>

                                <th>Department</th>

                                <th>Assigned To</th>

                                <th>Status</th>

                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var asset in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @asset.AssestCode
                                        </strong>
                                    </td>


                                    <td>
                                        @asset.AssestName
                                    </td>


                                    <td>
                                        @(asset.Category?.Name ?? "-")
                                    </td>


                                    <td>
                                        @(asset.SerialNumber ?? "-")
                                    </td>


                                    <td>
                                        @(asset.Location ?? "-")
                                    </td>


                                    <td>
                                        @(asset.Department ?? "-")
                                    </td>


                                    <td>
                                        @(asset.AssignedToUser?.FullName ?? "Not Assigned")
                                    </td>


                                    <td>

                                        @if (asset.Status == "Available")
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else if (asset.Status == "Assigned")
                                        {
                                            <span class="badge bg-primary">
                                                Assigned
                                            </span>
                                        }
                                        else if (asset.Status == "Under Maintenance")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Under Maintenance
                                            </span>
                                        }
                                        else if (asset.Status == "Damaged")
                                        {
                                            <span class="badge bg-danger">
                                                Damaged
                                            </span>
                                        }
                                        else if (asset.Status == "Retired")
                                        {
                                            <span class="badge bg-secondary">
                                                Retired
                                            </span>
                                        }
                                        else if (asset.Status == "Lost")
                                        {
                                            <span class="badge bg-dark">
                                                Lost
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @asset.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                    <h5 class="mt-3">
                        No assets found
                    </h5>
                    <p class="text-muted">
                        There are currently no assets in the inventory.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
