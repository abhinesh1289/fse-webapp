@model InventoryManagementSystem.Models.Organisation?
@{
    ViewData["Title"] = "Organisation";
}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-building"></i>
                Organisation
            </h2>
            <p class="text-muted mb-0">
                View organisation information.
            </p>
        </div>
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>
    </div>
    @if (Model == null)
    {
        <!-- No Organisation -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-building"
                   style="font-size: 60px;"></i>
                <h4 class="mt-4">
                    No Organisation Configured
                </h4>
                <p class="text-muted">
                    Organisation information has not been configured yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- Organisation Details -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-building"></i>
                    Organisation Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Organisation Name -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">
                                Organisation Name
                            </small>
                            <h5 class="mt-2 mb-0">
                                @Model.Name
                            </h5>
                        </div>
                    </div>
                    <!-- Email -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">
                                Email
                            </small>
                            <p class="mt-2 mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <a href="mailto:@Model.Email">
                                        @Model.Email
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                    <!-- Phone -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">
                                Phone
                            </small>
                            <p class="mt-2 mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    @Model.Phone
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                    <!-- Website -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">
                                Website
                            </small>
                            <p class="mt-2 mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.Website))
                                {
                                    <a href="@Model.Website"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        @Model.Website
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                    <!-- Address -->
                    <div class="col-12">
                        <div class="border rounded p-3">
                            <small class="text-muted">
                                Address
                            </small>
                            <p class="mt-2 mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.Address))
                                {
                                    @Model.Address
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
