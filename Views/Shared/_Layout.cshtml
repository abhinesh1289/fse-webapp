<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory_Managgement1.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var userName = ViewData["UserName"] as string ?? User.Identity?.Name;
        var userRole = ViewData["UserRole"] as string;
        var displayName = string.IsNullOrWhiteSpace(userName) ? "Guest" : userName;
        var initials = displayName.Length >= 2 ? displayName[..1].ToUpperInvariant() : "G";
    }

    <aside class="app-sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <span class="brand-icon"><i class="bi bi-box-seam-fill"></i></span>
            <div>
                <strong>Inventory</strong>
                <small>Management System</small>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a class="@(currentController == "Dashboard" ? "active" : null)" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>
            <a href="#">
                <i class="bi bi-box-seam"></i> Inventory
            </a>
            <a href="#">
                <i class="bi bi-tags"></i> Categories
            </a>
            <a href="#">
                <i class="bi bi-people"></i> Users
            </a>
            <a href="#">
                <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
            </a>
            <a href="#">
                <i class="bi bi-building"></i> Organisation
            </a>
            <a href="#">
                <i class="bi bi-bar-chart"></i> Reports
            </a>
            <a href="#">
                <i class="bi bi-bell"></i> Notifications
            </a>
            <a href="#">
                <i class="bi bi-person"></i> My Profile
            </a>
            <a href="#">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </nav>
    </aside>

    <div class="app-shell">
        <header class="app-header">
            <button type="button" class="icon-btn" id="sidebarToggle" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="header-actions">
                <button type="button" class="icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                </button>
                <div class="header-user">
                    <div class="user-copy">
                        <strong>@displayName</strong>
                        @if (!string.IsNullOrWhiteSpace(userRole))
                        {
                            <small>@userRole</small>
                        }
                    </div>
                    <div class="user-avatar" aria-hidden="true">@initials</div>
                </div>
            </div>
        </header>

        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
